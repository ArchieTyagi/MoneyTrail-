# Ollama:  LLM_BASE_URL=http://localhost:11434/v1                LLM_MODEL=qwen2.5:14b   (key can be anything)
# OpenAI:  leave LLM_BASE_URL empty                             LLM_MODEL=gpt-4o-mini
